import { expect, type Page, test } from '@playwright/test';

async function submit__Value__(page: Page, value: string) {
  await page.goto('/');
  await page.getByRole('textbox', { name: '__Field label__' }).fill(value);
  await page.getByRole('button', { name: '__Action__' }).click();
}

test.describe('__Route__', () => {
  test('__describes the user-visible journey through the api__', async ({ page }) => {
    const answered = page.waitForResponse((response) =>
      response.url().includes('/trpc/__router__.__procedure__'),
    );

    await submit__Value__(page, '__value__');

    expect((await answered).status()).toBe(200);
    await expect(page.getByRole('status')).toHaveText('__expected outcome__');
  });

  test('__describes the validation message for bad input__', async ({ page }) => {
    await submit__Value__(page, '__invalid value__');

    await expect(page.getByRole('alert')).toHaveText('__validation message__');
  });

  test('says so when the api fails', async ({ page }) => {
    await page.route('**/trpc/**', (route) =>
      route.fulfill({ status: 500, contentType: 'application/json', body: '{}' }),
    );

    await submit__Value__(page, '__value__');

    await expect(page.getByRole('alert')).toHaveText('__error message__');
  });
});
