{
  // StyleProof loads its configs by file name and the gallery by its index.html.
  "entry": [
    "playwright.styleproof.config.ts",
    "styleproof.config.ts",
    "{apps,showcase/*}/web/e2e/styleproof/{main.tsx,gallery.capture.ts}"
  ],
  // size-limit auto-loads its plugins (the @size-limit/* packages) from
  // package.json at runtime, so @size-limit/file is never `import`ed in source.
  // It is genuinely used by the `size` script — tell Fallow so the dependency
  // audit stays honest rather than flagging a false positive on every run.
  "ignoreDependencies": ["@size-limit/file"],

  // The api-client scaffold keeps both router types (ADR 0054), even when a
  // route uses only one. The structure gate pins the reference export surface.
  "ignoreExports": [
    {
      "file": "{apps,showcase/*}/web/src/api-client/index.ts",
      "exports": ["RouterInputs", "RouterOutputs"]
    }
  ],

  // Preserve the six independent recorded trial outputs (ADR 0059).
  // Duplication and health use separate ignore lists; keep their paths identical.
  "duplicates": {
    "ignore": [
      "showcase/todo-01/**",
      "showcase/todo-02/**",
      "showcase/todo-03/**",
      "showcase/todo-codex-01/**",
      "showcase/todo-codex-02/**",
      "showcase/todo-codex-03/**"
    ]
  },

  // Styling (including css-duplicate-block) uses health.ignore in Fallow 3.33.1.
  // Ben approved this generated-output scope on 23 October 2026 at 16:38 BST.
  "health": {
    "ignore": [
      "showcase/todo-01/**",
      "showcase/todo-02/**",
      "showcase/todo-03/**",
      "showcase/todo-codex-01/**",
      "showcase/todo-codex-02/**",
      "showcase/todo-codex-03/**"
    ]
  },

  // jest.style-stub.cjs is referenced as a string in jest.config.ts
  // (moduleNameMapper), not imported, so it isn't statically reachable. It is
  // used by every test run — exclude it from dead-file analysis.
  "ignorePatterns": ["jest.style-stub.cjs", "vendor/**"],

  // The contract's banned imports and calls per role (ADR 0032).
  "rulePacks": ["tooling/architecture/contract.rules.jsonc"],

  // `fallow audit` fails on every finding in the files a change touches, not
  // only the ones it introduces. That needs no base-revision pass, which reads
  // the base tree with this config and fails when the base predates a file the
  // config names, such as the rule pack above.
  "audit": { "gate": "all" },

  "rules": {
    // A rule-pack finding fails the gate, like a boundary violation.
    "policy-violation": "error",
    // Every fallow-ignore comment names its reason.
    "require-suppression-reason": "error"
  },

  // Architecture boundaries enforce the role table in
  // .agents/project/ARCHITECTURE.md (ADR 0032). Each role is a zone whose
  // patterns match every result by brace glob: the reference in `apps/` and
  // each `showcase/<id>/`. The reference web app also keeps one child zone per
  // route folder (autoDiscover), so a route that imports another route fails
  // here as well as in ESLint `policy/slice-isolation`, which owns sibling
  // isolation for every result; that rule also keeps one feature from importing
  // another. Web features are a single zone — a web feature, unlike a route,
  // is optional, so the zone has one member only when a result adds one.
  // The routes and features patterns name only files inside
  // a slice folder, so a loose file directly under `routes/` or `features/`
  // sits in no zone and `coverage.requireAllFiles` fails it. The patterns also
  // keep the config valid on a tree where those folders are missing, such as
  // the base revision `fallow audit` reads.
  // The rules below make Fallow FAIL (boundary-violation defaults to error) on
  // any value import they do not allow. This file is also the source for the role
  // diagram (pnpm arch:diagram).
  "boundaries": {
    "zones": [
      {
        "name": "web-app",
        "patterns": [
          "{apps,showcase/*}/web/src/main.tsx",
          "{apps,showcase/*}/web/src/App.tsx",
          "{apps,showcase/*}/web/src/index.css"
        ]
      },
      { "name": "web-api-client", "patterns": ["{apps,showcase/*}/web/src/api-client/**"] },
      {
        "name": "web-routes",
        "autoDiscover": ["apps/web/src/routes"],
        "patterns": ["{apps,showcase/*}/web/src/routes/*/**"]
      },
      {
        "name": "web-features",
        "patterns": ["{apps,showcase/*}/web/src/features/*/**"]
      },
      { "name": "ui", "patterns": ["packages/ui/src/**"] },
      {
        "name": "api-app",
        "patterns": ["{apps,showcase/*}/api/src/server.ts", "{apps,showcase/*}/api/src/router.ts"]
      },
      { "name": "api-trpc", "patterns": ["{apps,showcase/*}/api/src/trpc.ts"] },
      {
        "name": "api-procedures",
        "patterns": [
          "{apps,showcase/*}/api/src/features/*/{index,procedures}.ts",
          "{apps,showcase/*}/api/src/features/*/procedures/**"
        ]
      },
      {
        "name": "api-application",
        "patterns": [
          "{apps,showcase/*}/api/src/features/*/application.ts",
          "{apps,showcase/*}/api/src/features/*/application/**"
        ]
      },
      {
        "name": "api-domain",
        "patterns": [
          "{apps,showcase/*}/api/src/features/*/domain.ts",
          "{apps,showcase/*}/api/src/features/*/domain/**"
        ]
      },
      {
        "name": "api-integrations",
        "patterns": [
          "{apps,showcase/*}/api/src/features/*/integrations.ts",
          "{apps,showcase/*}/api/src/features/*/integrations/**"
        ]
      }
    ],
    // `allow` lists the roles a role may import by value. `allowTypeOnly` lists
    // every other role, so a type-only import (`import type`, `export type ...
    // from`) between any two roles passes (ADR 0037). A role is never listed
    // for itself: sibling slices stay isolated for types too.
    "rules": [
      // The composition root mounts the routes inside the api providers.
      {
        "from": "web-app",
        "allow": ["web-routes", "web-api-client", "ui"],
        "allowTypeOnly": [
          "web-features",
          "api-app",
          "api-trpc",
          "api-procedures",
          "api-application",
          "api-domain",
          "api-integrations"
        ]
      },
      // The api client wires the tRPC client over the router type; it imports
      // no other role by value.
      {
        "from": "web-api-client",
        "allow": [],
        "allowTypeOnly": [
          "web-app",
          "web-routes",
          "web-features",
          "ui",
          "api-app",
          "api-trpc",
          "api-procedures",
          "api-application",
          "api-domain",
          "api-integrations"
        ]
      },
      // A route composes a page from features, the api client and the ui kit.
      // Each route folder is its own child zone, so a route never imports
      // another route, not even a type.
      {
        "from": "web-routes",
        "allow": ["web-features", "web-api-client", "ui"],
        "allowTypeOnly": [
          "web-app",
          "api-app",
          "api-trpc",
          "api-procedures",
          "api-application",
          "api-domain",
          "api-integrations"
        ]
      },
      // A feature is shared web code that routes compose; one feature never
      // imports another, not even a type.
      {
        "from": "web-features",
        "allow": ["web-api-client", "ui"],
        "allowTypeOnly": [
          "web-app",
          "web-routes",
          "api-app",
          "api-trpc",
          "api-procedures",
          "api-application",
          "api-domain",
          "api-integrations"
        ]
      },
      // UI primitives import no other role by value.
      {
        "from": "ui",
        "allow": [],
        "allowTypeOnly": [
          "web-app",
          "web-api-client",
          "web-routes",
          "web-features",
          "api-app",
          "api-trpc",
          "api-procedures",
          "api-application",
          "api-domain",
          "api-integrations"
        ]
      },
      // The api composition root mounts the feature routers on the tRPC base.
      {
        "from": "api-app",
        "allow": ["api-trpc", "api-procedures"],
        "allowTypeOnly": [
          "web-app",
          "web-api-client",
          "web-routes",
          "web-features",
          "ui",
          "api-application",
          "api-domain",
          "api-integrations"
        ]
      },
      {
        "from": "api-trpc",
        "allow": [],
        "allowTypeOnly": [
          "web-app",
          "web-api-client",
          "web-routes",
          "web-features",
          "ui",
          "api-app",
          "api-procedures",
          "api-application",
          "api-domain",
          "api-integrations"
        ]
      },
      // Procedures validate input and delegate to application logic; they may
      // name domain types, never call domain code.
      {
        "from": "api-procedures",
        "allow": ["api-trpc", "api-application"],
        "allowTypeOnly": [
          "web-app",
          "web-api-client",
          "web-routes",
          "web-features",
          "ui",
          "api-app",
          "api-domain",
          "api-integrations"
        ]
      },
      {
        "from": "api-application",
        "allow": ["api-domain", "api-integrations"],
        "allowTypeOnly": [
          "web-app",
          "web-api-client",
          "web-routes",
          "web-features",
          "ui",
          "api-app",
          "api-trpc",
          "api-procedures"
        ]
      },
      // The domain is pure: it imports no other role by value.
      {
        "from": "api-domain",
        "allow": [],
        "allowTypeOnly": [
          "web-app",
          "web-api-client",
          "web-routes",
          "web-features",
          "ui",
          "api-app",
          "api-trpc",
          "api-procedures",
          "api-application",
          "api-integrations"
        ]
      },
      {
        "from": "api-integrations",
        // Storage persists domain types; it never calls domain rules.
        "allow": [],
        "allowTypeOnly": [
          "web-app",
          "web-api-client",
          "web-routes",
          "web-features",
          "ui",
          "api-app",
          "api-trpc",
          "api-procedures",
          "api-application",
          "api-domain"
        ]
      }
    ],
    "coverage": {
      // Every source file belongs to a role; no extra layers.
      "requireAllFiles": true,
      "allowUnmatched": [
        "**/*.test.{ts,tsx}",
        "**/*.d.ts",
        "**/*.d.mts",
        "{commitlint,jest,playwright}.config.ts",
        "playwright.styleproof.config.ts",
        "styleproof.config.ts",
        "jest.setup.ts",
        "jest.style-stub.cjs",
        "eslint.config.js",
        ".agents/team-walkthrough.html",
        "{apps,showcase/*}/web/{index.html,vite.config.ts}",
        "{apps,showcase/*}/web/e2e/**",
        ".claude/**",
        "scripts/**",
        "tooling/**",
        "vendor/**"
      ]
    }
  }
}
