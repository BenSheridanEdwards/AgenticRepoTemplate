{
  // size-limit auto-loads its plugins (the @size-limit/* packages) from
  // package.json at runtime, so @size-limit/file is never `import`ed in source.
  // It is genuinely used by the `size` script — tell Fallow so the dependency
  // audit stays honest rather than flagging a false positive on every run.
  "ignoreDependencies": ["@size-limit/file"],

  // jest.style-stub.cjs is referenced as a string in jest.config.ts
  // (moduleNameMapper), not imported, so it isn't statically reachable. It is
  // used by every test run — exclude it from dead-file analysis.
  "ignorePatterns": ["jest.style-stub.cjs", "vendor/**"],

  // Architecture boundaries enforce the role rules from
  // .agents/project/ARCHITECTURE.md. The "app" zone is the composition root
  // (main.tsx, App.tsx, index.css under apps/web/src). Each folder under
  // apps/web/src/routes and under apps/web/src/features becomes its own zone
  // (via autoDiscover), and a single "shared" zone holds cross-feature code.
  // The "patterns" on routes and features zone a file that sits directly in
  // that folder under the group's own rule, and keep the config valid on a tree
  // where the folder is missing, such as the base revision `fallow audit` reads.
  // The rules below make Fallow FAIL (boundary-violation defaults to error) on
  // any import they do not allow: app may import routes, routes may import
  // features and shared, features may import shared, and shared imports no
  // other role. This file is also the source for the role diagram
  // (pnpm arch:diagram) and the list of public module entries that get API
  // reports (pnpm api:report).
  "boundaries": {
    "zones": [
      {
        "name": "app",
        "patterns": ["apps/web/src/main.tsx", "apps/web/src/App.tsx", "apps/web/src/index.css"]
      },
      {
        "name": "routes",
        "autoDiscover": ["apps/web/src/routes"],
        "patterns": ["apps/web/src/routes/**"]
      },
      {
        "name": "features",
        "autoDiscover": ["apps/web/src/features"],
        "patterns": ["apps/web/src/features/**"]
      },
      { "name": "shared", "patterns": ["apps/web/src/shared/**"] }
    ],
    "rules": [
      // The composition root mounts routes into the DOM.
      { "from": "app", "allow": ["routes"] },
      // A route composes a page from features and shared code. A route never
      // imports another route.
      { "from": "routes", "allow": ["features", "shared"] },
      // "features" is the logical group of every autoDiscovered feature zone.
      // A group rule applies to each child feature: a feature may import shared
      // and its own files, and nothing else. A cross-feature import, or an
      // import of the app zone, matches no allow entry, so boundary-violation
      // (error) fails the audit.
      { "from": "features", "allow": ["shared"] },
      // Shared code is a leaf: it imports only its own files.
      { "from": "shared", "allow": [] }
    ]
  }
}
