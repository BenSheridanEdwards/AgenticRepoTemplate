#!/usr/bin/env sh
set -e

# Pre-commit = the FAST gates; each step finishes in under 30 seconds (ADR 0062).
# The up-to-date-with-main check runs on pre-push with the slower suite. See
# `.agents/decisions/0002-quality-gates-as-code.md`.

echo "› typecheck"
pnpm typecheck

echo "› biome (lint + format + imports, staged only)"
pnpm exec biome check --error-on-warnings --staged --no-errors-on-unmatched .

echo "› anti-slop (vendored Oxlint rules)"
pnpm lint:anti-slop

echo "› fallow (code intelligence: dead code, cycles, complexity)"
pnpm fallow:audit

echo "› secret scan (gitleaks, staged content)"
pnpm secret-scan
