#!/usr/bin/env sh
set -e

# Pre-push = the Definition of Done: the full local gate suite, then the E2E
# behaviour map. Nothing leaves the machine until both are green. Pre-commit
# runs only on staged files, and git skips it for a merge with no conflicts, so
# this is the one local gate a clean merge from main passes through (ADR 0026).

echo "› pushed branches up to date with origin/main"
sh scripts/require-up-to-date-main.sh --pushed-refs

# Git sets GIT_DIR for hooks in a linked worktree. Tests that create their own
# repos would then write to this one, so clear git's per-repo variables first.
unset $(git rev-parse --local-env-vars)

echo "› full local gate suite (pnpm verify)"
pnpm verify

echo "› end-to-end behaviour map (Playwright)"
pnpm e2e
