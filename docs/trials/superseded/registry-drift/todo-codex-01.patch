+import { createCallerFactory } from '../../trpc.ts';
+import { todosRouter } from './procedures.ts';
+
+const caller = createCallerFactory(todosRouter)({});
+it('validates and runs the todo lifecycle', async () => {
+  const todo = await caller.create({ title: '  Read  ' });
+  expect(todo.title).toBe('Read');
+  expect(await caller.list({})).toContainEqual(todo);
+  expect(await caller.toggle({ id: todo.id })).toEqual({ ...todo, completed: true });
+  await caller.delete({ id: todo.id });
+  await expect(caller.toggle({ id: todo.id })).rejects.toMatchObject({ code: 'NOT_FOUND' });
+});
+it.each(['', '   '])('rejects blank titles %j', async (title) => {
+  await expect(caller.create({ title })).rejects.toMatchObject({ code: 'BAD_REQUEST' });
+});
diff --git a/showcase/todo-codex-01/api/src/features/todos/procedures.ts b/showcase/todo-codex-01/api/src/features/todos/procedures.ts
new file mode 100644
index 0000000..a650dce
--- /dev/null
+++ b/showcase/todo-codex-01/api/src/features/todos/procedures.ts
@@ -0,0 +1,24 @@
+import { TRPCError } from '@trpc/server';
+import { Schema } from 'effect';
+import { procedure, router } from '../../trpc.ts';
+import { create, deleteTodo, list, toggle } from './application.ts';
+
+const emptyInput = Schema.Struct({});
+const titleInput = Schema.Struct({ title: Schema.Trim.check(Schema.isNonEmpty()) });
+const idInput = Schema.Struct({ id: Schema.String.check(Schema.isNonEmpty()) });
+export const todosRouter = router({
+  list: procedure.input(Schema.toStandardSchemaV1(emptyInput)).query(() => list()),
+  create: procedure
+    .input(Schema.toStandardSchemaV1(titleInput))
+    .mutation(({ input }) => create(input)),
+  toggle: procedure.input(Schema.toStandardSchemaV1(idInput)).mutation(({ input }) => {
+    const todo = toggle(input);
+    if (!todo) {
+      throw new TRPCError({ code: 'NOT_FOUND', message: 'Todo not found' });
+    }
+    return todo;
+  }),
+  delete: procedure
+    .input(Schema.toStandardSchemaV1(idInput))
+    .mutation(({ input }) => deleteTodo(input)),
+});
