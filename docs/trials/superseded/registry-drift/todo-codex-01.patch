@@ -0,0 +1,11 @@
+import { create, deleteTodo, list, toggle } from './application.ts';
+
+it('creates, lists, toggles and deletes an in-memory todo', () => {
+  const todo = create({ title: 'Read' });
+  expect(todo).toEqual({ id: expect.any(String), title: 'Read', completed: false });
+  expect(list()).toContainEqual(todo);
+  expect(toggle({ id: todo.id })).toEqual({ ...todo, completed: true });
+  deleteTodo({ id: todo.id });
+  expect(list()).not.toContainEqual(todo);
+  expect(toggle({ id: todo.id })).toBeUndefined();
+});
diff --git a/showcase/todo-codex-01/api/src/features/todos/application.ts b/showcase/todo-codex-01/api/src/features/todos/application.ts
