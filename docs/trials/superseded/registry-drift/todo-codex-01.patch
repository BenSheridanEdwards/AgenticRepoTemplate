@@ -0,0 +1,22 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+const todos = new Map<string, Todo>();
+export function listTodos(): Todo[] {
+  return [...todos.values()];
+}
+export function insertTodo(title: string): Todo {
+  const todo = { id: randomUUID(), title, completed: false };
+  todos.set(todo.id, todo);
+  return todo;
+}
+export function findTodo(id: string): Todo | undefined {
+  return todos.get(id);
+}
+export function saveTodo(todo: Todo): Todo {
+  todos.set(todo.id, todo);
+  return todo;
+}
+export function removeTodo(id: string): boolean {
+  return todos.delete(id);
+}
diff --git a/showcase/todo-codex-01/api/src/features/todos/procedures.test.ts b/showcase/todo-codex-01/api/src/features/todos/procedures.test.ts
