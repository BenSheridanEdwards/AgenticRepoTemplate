+const port = Schema.decodeUnknownSync(Port)(process.env.PORT ?? '3001');
+
+createHTTPServer({ router: appRouter, basePath: '/trpc/' }).listen(port, '127.0.0.1');
+
+console.log(`api listening on http://127.0.0.1:${port}/trpc`);
