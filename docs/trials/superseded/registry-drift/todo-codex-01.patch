+it('creates a trimmed title, toggles both ways and deletes', async () => {
+  let todos: { id: string; title: string; completed: boolean }[] = [];
+  const { user } = renderPage({
+    'todos.list': () => todos,
+    'todos.create': ({ title }) => {
+      const todo = { id: 'one', title, completed: false };
+      todos = [todo];
+      return todo;
+    },
+    'todos.toggle': ({ id }) => {
+      todos = todos.map((todo) => ({ ...todo, completed: !todo.completed }));
+      const todo = todos.find((todo) => todo.id === id);
+      if (!todo) {
+        throw new Error('Missing todo');
