+import { toggleTodo } from './domain.ts';
+import { deleteTodo, findTodo, insertTodo, listTodos, saveTodo } from './integrations.ts';
+
+export function list() {
+  return listTodos();
+}
+export function create(request: { readonly title: string }) {
+  return insertTodo(request.title);
+}
+export function toggle(request: { readonly id: string }) {
+  const todo = findTodo(request.id);
+  return todo ? saveTodo(toggleTodo(todo)) : null;
+}
+export function remove(request: { readonly id: string }) {
+  return deleteTodo(request.id);
+}
