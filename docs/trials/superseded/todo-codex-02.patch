@@ -0,0 +1,26 @@
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { type RouterInputs, type RouterOutputs, useTrpc } from '../../api-client';
+export function useTodos(): {
+  readonly todos: RouterOutputs['todos']['list'];
+  readonly loading: boolean;
+  readonly error: { readonly message: string } | null;
+  readonly create: (input: RouterInputs['todos']['create']) => Promise<unknown>;
+  readonly toggle: (input: RouterInputs['todos']['toggle']) => void;
+  readonly remove: (input: RouterInputs['todos']['delete']) => void;
+} {
+  const trpc = useTrpc();
+  const queryClient = useQueryClient();
+  const query = useQuery(trpc.todos.list.queryOptions());
+  const onSuccess = () => queryClient.invalidateQueries({ queryKey: trpc.todos.list.queryKey() });
+  const create = useMutation(trpc.todos.create.mutationOptions({ onSuccess }));
+  const toggle = useMutation(trpc.todos.toggle.mutationOptions({ onSuccess }));
+  const remove = useMutation(trpc.todos.delete.mutationOptions({ onSuccess }));
+  return {
+    todos: query.data ?? [],
+    loading: query.isPending,
+    error: query.error ?? create.error ?? toggle.error ?? remove.error,
+    create: create.mutateAsync,
+    toggle: toggle.mutate,
+    remove: remove.mutate,
+  };
+}
