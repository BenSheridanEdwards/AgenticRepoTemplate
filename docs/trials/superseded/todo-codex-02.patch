+import { Button, TextField } from '@repo/ui';
+import { useTodoForm } from './useTodoForm';
+export interface TodoFormProps {
+  readonly onCreate: (input: { title: string }) => Promise<unknown>;
+}
+export function TodoForm({ onCreate }: TodoFormProps) {
+  const { register, handleSubmit, reset, formState } = useTodoForm();
+  const handleCreate = handleSubmit(async (input) => {
+    try {
+      await onCreate(input);
+      reset();
+    } catch {
+      // The query hook exposes the mutation error on the page.
+    }
+  });
+  return (
+    <form onSubmit={handleCreate} noValidate>
+      <TextField label="Title" error={formState.errors.title?.message} {...register('title')} />
+      <Button type="submit" disabled={formState.isSubmitting}>
+        Add
+      </Button>
+    </form>
+  );
+}
