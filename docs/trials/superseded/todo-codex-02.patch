+import { render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { axe } from 'jest-axe';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { TodosPage } from './TodosPage';
+
+function renderPage(handlers: TestApiHandlers) {
+  return render(
+    <TestApiProvider handlers={handlers}>
+      <TodosPage />
+    </TestApiProvider>,
+  );
+}
+
+it('creates, toggles and deletes through the api', async () => {
+  let todos: { id: string; title: string; completed: boolean }[] = [];
+  renderPage({
+    'todos.list': () => todos,
+    'todos.create': ({ title }) => {
+      const todo = { id: 'one', title, completed: false };
+      todos = [todo];
+      return todo;
+    },
+    'todos.toggle': ({ id }) => {
+      todos = todos.map((todo) => ({ ...todo, completed: !todo.completed }));
+      return todos.find((todo) => todo.id === id) ?? null;
+    },
+    'todos.delete': () => {
+      todos = [];
+      return true;
+    },
+  });
+  const user = userEvent.setup();
+  await user.type(screen.getByRole('textbox', { name: 'Title' }), 'Read');
+  await user.click(screen.getByRole('button', { name: 'Add' }));
+  const checkbox = await screen.findByRole('checkbox', { name: 'Read' });
+  expect(checkbox).not.toBeChecked();
+  await user.click(checkbox);
+  await waitFor(() => expect(checkbox).toBeChecked());
+  await user.click(screen.getByRole('button', { name: 'Delete Read' }));
+  await waitFor(() => expect(screen.queryByRole('checkbox')).not.toBeInTheDocument());
+  expect(screen.getByRole('textbox')).toHaveValue('');
+});
+
+it('rejects blank titles and is accessible', async () => {
+  const create = jest.fn();
+  const { container } = renderPage({ 'todos.list': () => [], 'todos.create': create });
+  await screen.findByRole('list', { name: 'Todos' });
+  await userEvent.click(screen.getByRole('button', { name: 'Add' }));
+  expect(await screen.findByRole('alert')).toHaveTextContent('Enter a title');
+  expect(create).not.toHaveBeenCalled();
+  expect(await axe(container)).toHaveNoViolations();
+});
+
+it('shows a failed list request', async () => {
+  renderPage({});
+  expect(await screen.findByRole('alert')).toHaveTextContent('no handler for todos.list');
+});
+
+it('shows a failed create request and keeps the title', async () => {
+  renderPage({
+    'todos.list': () => [],
+    'todos.create': () => Promise.reject(new Error('Unavailable')),
+  });
+  await userEvent.type(screen.getByRole('textbox'), 'Read');
+  await userEvent.click(screen.getByRole('button', { name: 'Add' }));
+  expect(await screen.findByRole('alert')).toHaveTextContent('Unavailable');
+  expect(screen.getByRole('textbox')).toHaveValue('Read');
+});
