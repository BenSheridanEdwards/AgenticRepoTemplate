@@ -0,0 +1,22 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+const todos = new Map<string, Todo>();
+export function listTodos(): Todo[] {
+  return [...todos.values()];
+}
+export function insertTodo(title: string): Todo {
+  const todo = { id: randomUUID(), title, completed: false };
+  todos.set(todo.id, todo);
+  return todo;
+}
+export function findTodo(id: string): Todo | undefined {
+  return todos.get(id);
+}
+export function saveTodo(todo: Todo): Todo {
+  todos.set(todo.id, todo);
+  return todo;
+}
+export function deleteTodo(id: string): boolean {
+  return todos.delete(id);
+}
diff --git a/showcase/todo-codex-02/api/src/features/todos/procedures.test.ts b/showcase/todo-codex-02/api/src/features/todos/procedures.test.ts
new file mode 100644
index 0000000..280c93c
--- /dev/null
+++ b/showcase/todo-codex-02/api/src/features/todos/procedures.test.ts
@@ -0,0 +1,20 @@
+import { appRouter } from '../../router.ts';
+import { createCallerFactory } from '../../trpc.ts';
+
+const caller = createCallerFactory(appRouter)({});
+
+it('creates, lists, toggles twice and deletes a todo', async () => {
+  const todo = await caller.todos.create({ title: '  Read a book  ' });
+  expect(todo).toEqual({ id: expect.any(String), title: 'Read a book', completed: false });
+  expect(await caller.todos.list()).toContainEqual(todo);
+  expect(await caller.todos.toggle({ id: todo.id })).toEqual({ ...todo, completed: true });
+  expect(await caller.todos.toggle({ id: todo.id })).toEqual(todo);
+  expect(await caller.todos.delete({ id: todo.id })).toBe(true);
+  expect(await caller.todos.list()).not.toContainEqual(todo);
+  expect(await caller.todos.toggle({ id: todo.id })).toBeNull();
+  expect(await caller.todos.delete({ id: todo.id })).toBe(false);
+});
+
+it.each(['', '   '])('rejects blank titles %j', async (title) => {
+  await expect(caller.todos.create({ title })).rejects.toThrow();
+});
diff --git a/showcase/todo-codex-02/api/src/features/todos/procedures.ts b/showcase/todo-codex-02/api/src/features/todos/procedures.ts
