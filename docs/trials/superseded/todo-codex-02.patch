@@ -0,0 +1,20 @@
+import { Schema } from 'effect';
+import { procedure, router } from '../../trpc.ts';
+import { create, list, remove, toggle } from './application.ts';
+
+const titleInput = Schema.Struct({
+  title: Schema.Trim.check(Schema.isNonEmpty({ message: 'Enter a title' })),
+});
+const idInput = Schema.Struct({ id: Schema.String });
+export const todosRouter = router({
+  list: procedure.input(Schema.toStandardSchemaV1(Schema.Void)).query(() => list()),
+  create: procedure
+    .input(Schema.toStandardSchemaV1(titleInput))
+    .mutation(({ input }) => create(input)),
+  toggle: procedure
+    .input(Schema.toStandardSchemaV1(idInput))
+    .mutation(({ input }) => toggle(input)),
+  delete: procedure
+    .input(Schema.toStandardSchemaV1(idInput))
+    .mutation(({ input }) => remove(input)),
+});
