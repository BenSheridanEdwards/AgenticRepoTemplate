+import { Button } from '@repo/ui';
+import { TodoForm } from './TodoForm';
+import { useTodos } from './useTodos';
+export function TodosPage() {
+  const { todos, loading, error, create, toggle, remove } = useTodos();
+  return (
+    <main className="app">
+      <h1>Todos</h1>
+      <TodoForm onCreate={create} />
+      {loading ? <p role="status">Loading todos…</p> : null}
+      {error ? <p role="alert">{error.message}</p> : null}
+      <ul aria-label="Todos">
+        {todos.map((todo) => (
+          <li key={todo.id}>
+            <label>
+              <input
+                type="checkbox"
+                checked={todo.completed}
+                onChange={() => toggle({ id: todo.id })}
+              />
+              {todo.title}
+            </label>
+            <Button onClick={() => remove({ id: todo.id })} aria-label={`Delete ${todo.title}`}>
+              Delete
+            </Button>
+          </li>
+        ))}
+      </ul>
+    </main>
+  );
+}
