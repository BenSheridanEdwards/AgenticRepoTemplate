+import { Button, TextField } from '@repo/ui';
+import { useTodoForm } from './useTodoForm';
+export interface TodoFormProps {
+  readonly onAdd: (title: string) => void;
+  readonly pending: boolean;
+}
+export function TodoForm({ onAdd, pending }: TodoFormProps) {
+  const { register, handleSubmit, formState, reset } = useTodoForm();
+  const handleAdd = handleSubmit(({ title }) => {
+    onAdd(title);
+    reset();
+  });
+  return (
+    <form className="greeting-form" onSubmit={handleAdd} noValidate>
+      <TextField label="Title" error={formState.errors.title?.message} {...register('title')} />
+      <Button type="submit" disabled={pending}>
+        Add
+      </Button>
+    </form>
+  );
+}
