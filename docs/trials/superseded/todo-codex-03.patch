+++ b/showcase/todo-codex-03/api/src/features/todos/application.ts
@@ -0,0 +1,22 @@
+import { toggleTodo } from './domain.ts';
+import { insertTodo, readTodo, readTodos, removeTodo, storeTodo } from './integrations.ts';
+
+export function listTodos() {
+  return readTodos();
+}
+export function createTodo(title: string) {
+  return insertTodo(title);
+}
+export function toggleComplete(id: string) {
+  const todo = readTodo(id);
+  if (!todo) {
+    return undefined;
+  }
+  const updated = toggleTodo(todo);
+  storeTodo(updated);
+  return updated;
+}
+export function deleteTodo(id: string) {
+  removeTodo(id);
+  return { id };
+}
