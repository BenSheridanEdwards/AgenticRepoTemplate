@@ -0,0 +1,21 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+const todos = new Map<string, Todo>();
+export function readTodos(): Todo[] {
+  return [...todos.values()];
+}
+export function insertTodo(title: string): Todo {
+  const todo = { id: randomUUID(), title, completed: false };
+  todos.set(todo.id, todo);
+  return todo;
+}
+export function readTodo(id: string): Todo | undefined {
+  return todos.get(id);
+}
+export function storeTodo(todo: Todo): void {
+  todos.set(todo.id, todo);
+}
+export function removeTodo(id: string): void {
+  todos.delete(id);
+}
diff --git a/showcase/todo-codex-03/api/src/features/todos/procedures.test.ts b/showcase/todo-codex-03/api/src/features/todos/procedures.test.ts
