+import { Button } from '@repo/ui';
+import { TodoForm } from './TodoForm';
+import { useTodos } from './useTodos';
+export function TodosPage() {
+  const { todos, loading, failed, creating, toggling, deleting, add, toggle, remove } = useTodos();
+  const handleAdd = (title: string) => add(title);
+  return (
+    <main className="app">
+      <h1>Todos</h1>
+      <section className="greeting" aria-label="Manage todos">
+        <TodoForm onAdd={handleAdd} pending={creating} />
+        {loading ? <p role="status">Loading todos…</p> : null}
+        {failed ? <p role="alert">Could not save or load todos. Please try again.</p> : null}
+        <ul aria-label="Todos">
+          {todos?.map((todo) => (
+            <li key={todo.id}>
+              <label>
+                <input
+                  type="checkbox"
+                  checked={todo.completed}
+                  disabled={toggling}
+                  onChange={() => toggle(todo.id)}
+                />
+                {todo.title}
+              </label>
+              <Button
+                aria-label={`Delete ${todo.title}`}
+                disabled={deleting}
+                onClick={() => remove(todo.id)}
+              >
+                Delete
+              </Button>
+            </li>
+          ))}
+        </ul>
+      </section>
+    </main>
+  );
+}
