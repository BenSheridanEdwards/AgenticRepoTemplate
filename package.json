{
  "name": "agentic-repo-template",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A reference scaffold for agentic engineering: the files, gates, and context that make AI agents produce consistent, enterprise-quality code.",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @repo/web --filter @repo/api dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @repo/web preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "lint:policy": "eslint --max-warnings=0 .",
    "react-doctor": "react-doctor . --no-lint --no-supply-chain --no-telemetry --blocking warning --yes",
    "fallow:audit": "bash scripts/fallow-audit.sh",
    "arch:gate": "fallow architecture -q",
    "arch:diagram": "node scripts/fallow-roles.mjs",
    "arch:check": "pnpm arch:gate && pnpm arch:diagram && git diff --exit-code docs/architecture/roles.mmd && pnpm api:check",
    "api:report": "node scripts/api-report.mjs --local",
    "api:check": "node scripts/api-report.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "secret-scan": "bash scripts/secret-scan.sh",
    "license:check": "node scripts/license-check.mjs",
    "check:context": "node scripts/check-context-layer.mjs",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "check:adr": "node scripts/check-dependency-adr.mjs",
    "check:docs": "node scripts/check-doc-phrasing.mjs && node scripts/check-sign-off-docs.mjs",
    "gates:inventory": "node scripts/required-gates.mjs --write",
    "gates:check": "node scripts/required-gates.mjs --check",
    "validate:pr": "node scripts/validate-pr-body.mjs",
    "verify": "pnpm check:context && pnpm check:suppressions && pnpm check:docs && pnpm gates:check && pnpm check:adr && pnpm typecheck && pnpm check && pnpm lint:policy && pnpm react-doctor && pnpm fallow:audit && pnpm arch:check && pnpm test:coverage && pnpm build && pnpm size",
    "setup:agents": "bash scripts/setup-agentic-toolkit.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^2.5.1",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/types": "^19.5.0",
    "@lhci/cli": "^0.15.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "^1.49.1",
    "@size-limit/file": "^12.1.0",
    "@swc/core": "^1.10.7",
    "@swc/jest": "^0.2.37",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-doctor": "0.9.18",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fallow": "3.33.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "react-doctor": "0.9.18",
    "size-limit": "^12.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  }
}
