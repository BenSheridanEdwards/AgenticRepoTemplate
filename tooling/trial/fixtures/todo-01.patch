+import {
+  findStoredTodo,
+  listStoredTodos,
+  newTodoId,
+  removeStoredTodo,
+  storeTodo,
+} from './integrations.ts';
+
+it('stores, replaces, lists and removes todos in insertion order', () => {
+  const first = { id: newTodoId(), title: 'First', completed: false };
+  const second = { id: newTodoId(), title: 'Second', completed: false };
+
+  storeTodo(first);
+  storeTodo(second);
+  storeTodo({ ...first, completed: true });
+
+  expect(listStoredTodos()).toEqual([{ ...first, completed: true }, second]);
+  expect(findStoredTodo(second.id)).toEqual(second);
+  expect(removeStoredTodo(first.id)).toBe(true);
+  expect(removeStoredTodo(first.id)).toBe(false);
+  expect(listStoredTodos()).toEqual([second]);
+});
+
+it('gives each todo a different id', () => {
+  expect(newTodoId()).not.toBe(newTodoId());
+});
diff --git a/showcase/todo-01/api/src/features/todos/integrations.ts b/showcase/todo-01/api/src/features/todos/integrations.ts
new file mode 100644
index 0000000..f1e9f09
--- /dev/null
+++ b/showcase/todo-01/api/src/features/todos/integrations.ts
@@ -0,0 +1,26 @@
+import { randomUUID } from 'node:crypto';
+import type { Todo } from './domain.ts';
+
+// The todos live in memory, inside the api process, for as long as it runs.
+const todos = new Map<string, Todo>();
+
+export function newTodoId(): string {
+  return randomUUID();
+}
+
+export function listStoredTodos(): readonly Todo[] {
+  return [...todos.values()];
+}
+
+export function findStoredTodo(id: string): Todo | undefined {
+  return todos.get(id);
+}
+
+export function storeTodo(todo: Todo): void {
+  todos.set(todo.id, todo);
+}
+
+/** Removes the todo and says whether it was there. */
+export function removeStoredTodo(id: string): boolean {
+  return todos.delete(id);
+}
