@@ -0,0 +1,31 @@
+import { TodoItem } from './TodoItem';
+import type { TodosState } from './useTodos';
+
+export interface TodoListProps {
+  readonly todos: TodosState;
+  readonly onToggle: (id: string) => void;
+  readonly onDelete: (id: string) => void;
+}
+
+export function TodoList({ todos, onToggle, onDelete }: TodoListProps) {
+  if (todos.status === 'loading') {
+    return <p className="todo-note">Loading…</p>;
+  }
+  if (todos.status === 'error') {
+    return (
+      <p role="alert" className="todo-error">
+        Could not load the todos
+      </p>
+    );
+  }
+  if (todos.todos.length === 0) {
+    return <p className="todo-note">No todos yet</p>;
+  }
+  return (
+    <ul className="todo-list" aria-label="Todos">
+      {todos.todos.map((todo) => (
+        <TodoItem key={todo.id} todo={todo} onToggle={onToggle} onDelete={onDelete} />
+      ))}
+    </ul>
+  );
+}
diff --git a/showcase/todo-01/web/src/routes/todos/TodosPage.test.tsx b/showcase/todo-01/web/src/routes/todos/TodosPage.test.tsx
