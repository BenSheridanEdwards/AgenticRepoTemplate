@@ -0,0 +1,28 @@
+import { createTodo, deleteTodo, listTodos, toggleTodo } from './application.ts';
+
+it('creates a todo that is not complete and lists it', () => {
+  const todo = createTodo({ title: 'Buy milk' });
+
+  expect(todo).toEqual({ id: expect.any(String), title: 'Buy milk', completed: false });
+  expect(listTodos()).toContainEqual(todo);
+});
+
+it('toggles a todo complete and back, and keeps each state', () => {
+  const { id } = createTodo({ title: 'Walk the dog' });
+
+  expect(toggleTodo({ id })).toMatchObject({ id, completed: true });
+  expect(listTodos()).toContainEqual(expect.objectContaining({ id, completed: true }));
+  expect(toggleTodo({ id })).toMatchObject({ id, completed: false });
+});
+
+it('deletes a todo so it is no longer listed', () => {
+  const { id } = createTodo({ title: 'Water the plants' });
+
+  expect(deleteTodo({ id })).toBe(true);
+  expect(listTodos()).not.toContainEqual(expect.objectContaining({ id }));
+});
+
+it('finds nothing to toggle or delete for an unknown id', () => {
+  expect(toggleTodo({ id: 'missing' })).toBeUndefined();
+  expect(deleteTodo({ id: 'missing' })).toBe(false);
+});
diff --git a/showcase/todo-01/api/src/features/todos/application.ts b/showcase/todo-01/api/src/features/todos/application.ts
new file mode 100644
index 0000000..d99ec4e
--- /dev/null
+++ b/showcase/todo-01/api/src/features/todos/application.ts
@@ -0,0 +1,42 @@
+import { newTodo, type Todo, toggleCompleted } from './domain.ts';
+import {
+  findStoredTodo,
+  listStoredTodos,
+  newTodoId,
+  removeStoredTodo,
+  storeTodo,
+} from './integrations.ts';
+
+export interface CreateTodoRequest {
+  readonly title: string;
+}
+
+export interface TodoIdRequest {
+  readonly id: string;
+}
+
+export function listTodos(): readonly Todo[] {
+  return listStoredTodos();
+}
+
+export function createTodo(request: CreateTodoRequest): Todo {
+  const todo = newTodo(newTodoId(), request.title);
+  storeTodo(todo);
+  return todo;
+}
+
+/** The toggled todo, or `undefined` when no todo has the id. */
+export function toggleTodo(request: TodoIdRequest): Todo | undefined {
+  const todo = findStoredTodo(request.id);
+  if (!todo) {
+    return undefined;
+  }
+  const toggled = toggleCompleted(todo);
+  storeTodo(toggled);
+  return toggled;
+}
+
+/** Whether a todo with the id was there to delete. */
+export function deleteTodo(request: TodoIdRequest): boolean {
+  return removeStoredTodo(request.id);
+}
