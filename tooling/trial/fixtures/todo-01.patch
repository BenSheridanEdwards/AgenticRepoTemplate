@@ -0,0 +1,31 @@
+import { TRPCError } from '@trpc/server';
+import { Schema } from 'effect';
+import { procedure, router } from '../../trpc.ts';
+import { createTodo, deleteTodo, listTodos, toggleTodo } from './application.ts';
+
+const createInputSchema = Schema.Struct({ title: Schema.Trim.pipe(Schema.nonEmptyString()) });
+
+const todoIdInputSchema = Schema.Struct({ id: Schema.NonEmptyString });
+
+const notFound = (id: string) =>
+  new TRPCError({ code: 'NOT_FOUND', message: `No todo has the id ${id}` });
+
+export const todosRouter = router({
+  list: procedure.query(() => listTodos()),
+  create: procedure
+    .input(Schema.standardSchemaV1(createInputSchema))
+    .mutation(({ input }) => createTodo(input)),
+  toggle: procedure.input(Schema.standardSchemaV1(todoIdInputSchema)).mutation(({ input }) => {
+    const todo = toggleTodo(input);
+    if (!todo) {
+      throw notFound(input.id);
+    }
+    return todo;
+  }),
+  delete: procedure.input(Schema.standardSchemaV1(todoIdInputSchema)).mutation(({ input }) => {
+    if (!deleteTodo(input)) {
+      throw notFound(input.id);
+    }
+    return { id: input.id };
+  }),
+});
