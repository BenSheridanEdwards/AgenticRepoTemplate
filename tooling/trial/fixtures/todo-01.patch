@@ -0,0 +1,51 @@
+import { act, renderHook, waitFor } from '@testing-library/react';
+import type { ReactNode } from 'react';
+import { type TestApiHandlers, TestApiProvider } from '../../api-client';
+import { useTodos } from './useTodos';
+
+function renderTodos(handlers: TestApiHandlers) {
+  const wrapper = ({ children }: { children: ReactNode }) => (
+    <TestApiProvider handlers={handlers}>{children}</TestApiProvider>
+  );
+  return renderHook(() => useTodos(), { wrapper });
+}
+
+const todo = { id: '1', title: 'Buy milk', completed: false };
+
+it('loads, then holds the todos', async () => {
+  const { result } = renderTodos({ 'todos.list': () => [todo] });
+
+  expect(result.current.todos).toEqual({ status: 'loading' });
+  await waitFor(() => expect(result.current.todos).toEqual({ status: 'success', todos: [todo] }));
+});
+
+it('reports a failed load', async () => {
+  const { result } = renderTodos({ 'todos.list': () => Promise.reject(new Error('api down')) });
+
+  await waitFor(() => expect(result.current.todos).toEqual({ status: 'error' }));
+});
+
+it('refreshes the todos after a change is saved', async () => {
+  const list = jest.fn().mockReturnValueOnce([]).mockReturnValue([todo]);
+  const create = jest.fn(() => todo);
+  const { result } = renderTodos({ 'todos.list': list, 'todos.create': create });
+  await waitFor(() => expect(result.current.todos).toEqual({ status: 'success', todos: [] }));
+
+  act(() => result.current.addTodo('Buy milk'));
+
+  await waitFor(() => expect(result.current.todos).toEqual({ status: 'success', todos: [todo] }));
+  expect(create).toHaveBeenCalledWith({ title: 'Buy milk' });
+  expect(result.current.saveFailed).toBe(false);
+});
+
+it('reports a change that could not be saved', async () => {
+  const { result } = renderTodos({
+    'todos.list': () => [todo],
+    'todos.toggle': () => Promise.reject(new Error('api down')),
+  });
+  await waitFor(() => expect(result.current.todos.status).toBe('success'));
+
+  act(() => result.current.toggleTodo('1'));
+
+  await waitFor(() => expect(result.current.saveFailed).toBe(true));
+});
