+import AxeBuilder from '@axe-core/playwright';
+import { expect, type Page, test } from '@playwright/test';
+
+/**
+ * Real-browser accessibility scan, in Chromium so axe can evaluate computed
+ * styles: colour contrast, focus visibility, real roles.
+ */
+const scan = (page: Page) =>
+  new AxeBuilder({ page }).withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa']).analyze();
+
+test.describe('Accessibility', () => {
+  test('the todos page has no detectable WCAG A/AA violations', async ({ page }) => {
+    await page.goto('/');
+    await expect(page.getByRole('button', { name: 'Add', exact: true })).toBeVisible();
+
+    expect((await scan(page)).violations).toEqual([]);
+  });
+
+  test('the validation error state has no detectable WCAG A/AA violations', async ({ page }) => {
+    await page.goto('/');
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+
+    expect((await scan(page)).violations).toEqual([]);
+  });
+
+  test('a completed todo has no detectable WCAG A/AA violations', async ({ page }) => {
+    const title = `Read a book ${Date.now()}`;
+    await page.goto('/');
+    await page.getByRole('textbox', { name: 'Title' }).fill(title);
+    await page.getByRole('button', { name: 'Add', exact: true }).click();
+    const checkbox = page.getByRole('checkbox', { name: title, exact: true });
+    await checkbox.click();
+    await expect(checkbox).toBeChecked();
+
+    expect((await scan(page)).violations).toEqual([]);
+  });
+});
diff --git a/showcase/todo-01/web/e2e/todos.spec.ts b/showcase/todo-01/web/e2e/todos.spec.ts
new file mode 100644
index 0000000..cdd58bc
--- /dev/null
+++ b/showcase/todo-01/web/e2e/todos.spec.ts
@@ -0,0 +1,90 @@
+import { randomUUID } from 'node:crypto';
+import { expect, type Page, test } from '@playwright/test';
+
+/**
+ * The todo behaviour, end to end: the page in Chromium, the Vite server's
+ * `/trpc` proxy, and the real api process. The tests share one api, so each
+ * makes its own titles and never counts todos.
+ */
+const newTitle = (label: string) => `${label} ${randomUUID().slice(0, 8)}`;
+
+const todoList = (page: Page) => page.getByRole('list', { name: 'Todos' });
+
+async function submitTitle(page: Page, title: string) {
+  await page.getByRole('textbox', { name: 'Title' }).fill(title);
+  await page.getByRole('button', { name: 'Add', exact: true }).click();
+}
+
+test.beforeEach(async ({ page }) => {
+  await page.goto('/');
+});
+
+test.describe('Todos', () => {
+  test('creates a todo through the api with the trimmed title', async ({ page }) => {
+    const title = newTitle('Buy milk');
+    const created = page.waitForResponse((response) =>
+      response.url().includes('/trpc/todos.create'),
+    );
+
+    await submitTitle(page, `  ${title} `);
+
+    expect((await created).status()).toBe(200);
+    await expect(
+      todoList(page).getByRole('checkbox', { name: title, exact: true }),
+    ).not.toBeChecked();
+    await expect(page.getByRole('textbox', { name: 'Title' })).toHaveValue('');
+  });
+
+  test('asks for a title and sends no create request when the title is blank', async ({ page }) => {
+    const creates: string[] = [];
+    page.on('request', (request) => {
+      if (request.url().includes('/trpc/todos.create')) {
+        creates.push(request.url());
+      }
+    });
+
+    await submitTitle(page, '   ');
+
+    await expect(page.getByRole('alert')).toHaveText('Enter a title');
+    await expect(page.getByRole('textbox', { name: 'Title' })).toHaveAttribute(
+      'aria-invalid',
+      'true',
+    );
+    expect(creates).toEqual([]);
+  });
+
+  test('toggles and deletes a todo, keeping each change across a reload', async ({ page }) => {
+    const title = newTitle('Walk the dog');
+    await submitTitle(page, title);
+    const checkbox = todoList(page).getByRole('checkbox', { name: title, exact: true });
+    await expect(checkbox).toBeVisible();
+
+    await checkbox.click();
+    await expect(checkbox).toBeChecked();
+    await page.reload();
+    await expect(checkbox).toBeChecked();
+
+    await page.getByRole('button', { name: `Delete ${title}`, exact: true }).click();
+    await expect(checkbox).toHaveCount(0);
+    await page.reload();
+    await expect(page.getByRole('heading', { level: 1, name: 'Todos' })).toBeVisible();
+    await expect(checkbox).toHaveCount(0);
+  });
+
+  test('the api rejects a blank title as a bad request', async ({ request }) => {
+    const response = await request.post('/trpc/todos.create', { data: { title: '   ' } });
+
+    expect(response.status()).toBe(400);
+    expect(await response.json()).toMatchObject({ error: { data: { code: 'BAD_REQUEST' } } });
+  });
+
+  test('says so when the api fails', async ({ page }) => {
+    await page.route('**/trpc/**', (route) =>
+      route.fulfill({ status: 500, contentType: 'application/json', body: '{}' }),
+    );
+
+    await page.reload();
+
+    await expect(page.getByRole('alert')).toHaveText('Could not load the todos');
+  });
+});
