{
  "name": "todo",
  "prompt": "tooling/trial/todo-prompt.md",
  "target": null,
  "allowedPaths": ["showcase/{{ID}}/"],
  "setup": [
    {
      "name": "install",
      "argv": ["pnpm", "install", "--frozen-lockfile"]
    }
  ],
  "checks": [
    {
      "name": "install",
      "argv": ["pnpm", "install", "--frozen-lockfile"]
    },
    {
      "name": "verify",
      "argv": ["pnpm", "verify"]
    },
    {
      "name": "e2e",
      "argv": ["pnpm", "e2e"]
    },
    {
      "name": "structure",
      "argv": ["node", "tooling/architecture/structure.mjs"]
    },
    {
      "name": "scope",
      "argv": ["node", "tooling/trial/check-scope.mjs", "--id", "{{ID}}"]
    }
  ],
  "ports": [5173, 3001, 5183, 3011],
  "enforcementPaths": [
    ".agents/hooks",
    ".agents/skills",
    ".husky",
    ".github/workflows",
    ".claude",
    ".codex",
    ".cursor",
    ".fallowrc.jsonc",
    ".npmrc",
    "biome.json",
    "commitlint.config.ts",
    "eslint.config.js",
    "jest.config.ts",
    "package.json",
    "playwright.config.ts",
    "pnpm-workspace.yaml",
    "scripts",
    "tooling",
    ":(glob)tsconfig*.json"
  ],
  "land": "showcase"
}
