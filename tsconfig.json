{
  // The browser program: every web package, the ui kit, and the root configs.
  // It reaches the api only through the type-only `@repo/api` contract, whose
  // source uses explicit `.ts` import extensions.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,

    "types": ["node", "jest", "@testing-library/jest-dom"]
  },
  "include": [
    "apps/web/src",
    "apps/web/e2e",
    "apps/web/vite.config.ts",
    "showcase/*/web/src",
    "showcase/*/web/e2e",
    "showcase/*/web/vite.config.ts",
    "packages/ui/src",
    "tooling/results.d.mts",
    "jest.config.ts",
    "jest.setup.ts",
    "commitlint.config.ts",
    "playwright.config.ts"
  ],
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node",
      "verbatimModuleSyntax": false
    }
  }
}
